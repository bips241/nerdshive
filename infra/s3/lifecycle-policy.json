{
  "Rules": [
    {
      "ID": "TempUploadsAutoPurge",
      "Status": "Enabled",
      "Filter": {
        "Prefix": "uploads/temp/"
      },
      "Expiration": {
        "Days": 1
      }
    },
    {
      "ID": "ActiveMediaIntelligentTiering",
      "Status": "Enabled",
      "Filter": {
        "Prefix": "uploads/"
      },
      "Transitions": [
        {
          "Days": 30,
          "StorageClass": "INTELLIGENT_TIERING"
        }
      ]
    },
    {
      "ID": "TombstonedMediaRetention180Days",
      "Status": "Enabled",
      "Filter": {
        "Prefix": "tombstone/"
      },
      "Transitions": [
        {
          "Days": 30,
          "StorageClass": "GLACIER"
        }
      ],
      "Expiration": {
        "Days": 180
      }
    },
    {
      "ID": "NoncurrentVersionHistoryCleanup",
      "Status": "Enabled",
      "Filter": {},
      "NoncurrentVersionExpiration": {
        "NoncurrentDays": 30
      },
      "AbortIncompleteMultipartUpload": {
        "DaysAfterInitiation": 7
      }
    },
    {
      "ID": "DatabaseBackupStatutoryArchive",
      "Status": "Enabled",
      "Filter": {
        "Prefix": "backups/"
      },
      "Transitions": [
        {
          "Days": 30,
          "StorageClass": "GLACIER_IR"
        },
        {
          "Days": 90,
          "StorageClass": "DEEP_ARCHIVE"
        }
      ],
      "Expiration": {
        "Days": 365
      }
    }
  ]
}
