# ==============================================================================
# NerdShive / DevConnect — Enterprise Environment Configuration Blueprint
# ==============================================================================

# --- Application & BFF Configuration ---
NODE_ENV=development
PORT=3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-32-character-random-nextauth-secret-here
AUTH_TRUST_HOST=true

# --- Database Tier (MongoDB Atlas / Local) ---
MONGODB_URI=mongodb://localhost:27017/nerdshive

# --- Redis Tier (Streams, Queues, PubSub & Adapter) ---
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- OAuth Providers (Google & GitHub) ---
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# --- Email Gateway (Resend) ---
RESEND_API_KEY=re_your_resend_api_key_here

# --- Media Storage Tier (AWS S3 & CloudFront CDN) ---
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_BUCKET_NAME=nerdshive-bucket
AWS_BUCKET_REGION=ap-south-1
CDN_DOMAIN=cdn.nerdshive.online

# --- Microservices & gRPC Internal Tier ---
GATEWAY_PORT=4000
GRPC_AUTH_PORT=50051
GRPC_MEDIA_PORT=50052
GRPC_MATCH_PORT=50053
GRPC_CHAT_PORT=50054
GRPC_DISCOVERY_PORT=50055

# --- Real-Time Video & WebRTC Signaling Tier ---
NEXT_PUBLIC_SOCKET_SERVER_URL=http://localhost:10000
NEXT_PUBLIC_PEER_SERVER_HOST=peer-server-zr5n.onrender.com
NEXT_PUBLIC_PEER_SERVER_PORT=443
NEXT_PUBLIC_PEER_SERVER_PATH=/peerjs

# --- Metered STUN / TURN Credentials ---
NEXT_PUBLIC_METERED_STUN_URL=stun:stun.relay.metered.ca:80
NEXT_PUBLIC_METERED_TURN_URL=turn:standard.relay.metered.ca:80
NEXT_PUBLIC_METERED_TURN_TCP_URL=turn:standard.relay.metered.ca:80?transport=tcp
NEXT_PUBLIC_METERED_TURN_443_URL=turn:standard.relay.metered.ca:443
NEXT_PUBLIC_METERED_TURNS_443_TCP_URL=turns:standard.relay.metered.ca:443?transport=tcp
NEXT_PUBLIC_METERED_TURN_USERNAME=your-metered-turn-username
NEXT_PUBLIC_METERED_TURN_CREDENTIAL=your-metered-turn-credential

# --- [DEPRECATED / NOT REQUIRED] Direct Messaging Tier (Firebase Firestore) ---
# Direct messaging and squad channels are powered natively by Socket.IO + MongoDB + Redis.
# You do NOT need to set these variables for local development or production.
# NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-firebase-auth-domain
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-firebase-storage-bucket
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-firebase-messaging-sender-id
# NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id

