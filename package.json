{
  "name": "nerdshive",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "start": "npm --prefix web run start",
    "lint": "npm --prefix web run lint",
    "dev:web": "npm --prefix web run dev",
    "build:web": "npm --prefix web run build",
    "start:gateway": "ts-node apps/api-gateway/src/main.ts",
    "start:auth": "ts-node apps/auth-service/src/main.ts",
    "start:media": "ts-node apps/media-service/src/main.ts",
    "start:match": "ts-node apps/match-service/src/main.ts",
    "start:discovery": "ts-node apps/discovery-service/src/main.ts",
    "start:notification": "ts-node apps/notification-service/src/main.ts",
    "test:grpc": "node tests/grpc/grpc-integration-test.js",
    "test:s3": "node tests/load-tests/s3-resilience-test.js",
    "test:match": "node tests/load-tests/match-scaling-test.js",
    "test:chaos": "node tests/chaos-monkey/run-1000-users-chaos-test.js",
    "test:chat": "node tests/chat/signaling-concurrency-test.js",
    "seo:audit": "node scripts/seo-analytics-report.js",
    "seo:boost": "node scripts/daily-seo-booster.js",
    "analytics:report": "node scripts/fetch-google-analytics.js",
    "seo:daily": "node scripts/daily-seo-booster.js && node scripts/seo-analytics-report.js && node scripts/fetch-google-analytics.js",
    "db:seed": "node scripts/seed-db.js",
    "db:backup": "node scripts/infra/backup-mongodb.js",
    "db:dr-drill": "node scripts/infra/verify-restore-drill.js",
    "db:retention": "node scripts/infra/retention-janitor.js",
    "s3:retention": "node scripts/infra/setup-s3-retention-policy.js",
    "test:retention": "node tests/integration/soft-delete-retention-test.js",
    "test:schema": "node tests/schema/schema-backward-compatibility-test.js",
    "test:rbac": "node tests/security/rbac-bypass-proof-test.js",
    "test:hackathon": "node tests/integration/hackathon-ecosystem-test.js",
    "test:rooms": "node tests/chat/segregated-video-rooms-test.js",
    "test:all": "npm run test:schema && npm run test:retention && npm run test:rbac && npm run test:hackathon && npm run test:rooms",
    "env:check": "node scripts/infra/validate-env.js",
    "ci:validate": "npm run lint && npm run env:check && npm run test:all && npm run build"
  },
  "workspaces": [
    "web",
    "apps/*",
    "libs/*"
  ],
