{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@/*": ["./web/*"],
      "@nerdshive/database": ["./libs/database"],
      "@nerdshive/events": ["./libs/events"],
      "@nerdshive/common": ["./libs/common"]
    }
  },
  "include": ["web/**/*.ts", "web/**/*.tsx", "apps/**/*.ts", "libs/**/*.ts"],
  "exclude": ["node_modules", "web/.next"]
}
